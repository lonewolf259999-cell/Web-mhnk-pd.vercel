# Copy this file to .env (local dev) or set these directly in the host's
# environment settings (DirectAdmin Node.js Selector / Vercel project settings).
# Never commit a real .env — it is already gitignored.

# --- Required: site will 500 on any endpoint that needs a missing one ---

# Google Sheet ID behind the officer roster (NamePD sheet) and weekly stats.
SHEET_ID=

# Google Sheet ID behind the CaseAll (weekly case tabs) sheet.
CASES_SHEET_ID=

# Google Sheet ID behind the conduct/rules/fines sheets.
RULES_SHEET_ID=

# Shared PIN gating every admin action (mark-paid, roster edits, rule CRUD,
# pending-registration approval). Plain string, compared in constant time.
ADMIN_PIN=

# Full Google service-account JSON key, as a single-line string (not a file
# path — there is no credentials.json fallback). Required by any endpoint
# that writes to Sheets or reads rules/conduct/fines/cases.
GOOGLE_JSON_KEY=

# --- Required for Discord OAuth login (register/medical/proctor/rostermanage) ---

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Must exactly match the host actually serving the site AND the redirect
# registered in the Discord Developer Portal (including www vs apex).
APP_URL=http://localhost:3000

# --- Discord webhook URLs (registration/roster notifications) ---

DISCORD_REGISTER_WEBHOOK_URL=
DISCORD_MEDICAL_WEBHOOK_URL=
DISCORD_PROCTOR_WEBHOOK_URL=
DISCORD_COUNCIL_WEBHOOK_URL=
DISCORD_OUTPD_WEBHOOK_URL=

# --- Optional: sensible defaults exist in server/config.ts ---

# Defaults to a fixed sheet ID if unset.
# CASES_DATA_SHEET_ID=

# Both default to SHEET_ID if unset.
# PENDING_SPREADSHEET_ID=
# ROSTER_SHEET_ID=

# Defaults to "Pending" if unset.
# PENDING_SHEET_NAME=

# Port Next.js listens on when self-hosting via server.js (DirectAdmin
# Node.js Selector sets this for you; only needed for manual `node server.js`).
# PORT=3000
