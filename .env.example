# ─────────────────────────────────────────────────────────────
# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่า — .env ถูก gitignore ไว้แล้ว
# ไฟล์นี้ต้องมีเฉพาะ "ชื่อตัวแปร" เท่านั้น ห้ามใส่ค่าจริงลงไป
# อัปเดตไฟล์นี้คู่กับ server/config.ts เสมอ
# บน DirectAdmin / cPanel ให้ตั้งค่าเหล่านี้ที่ Node.js Selector แทนการอัปโหลด .env
# ─────────────────────────────────────────────────────────────

# ── จำเป็น: Google Sheets ที่ใช้เป็นฐานข้อมูล ──
# เอา ID จาก URL ของชีต: docs.google.com/spreadsheets/d/<ID>/edit
SHEET_ID=
CASES_SHEET_ID=
RULES_SHEET_ID=

# ── จำเป็น: บัญชี service account ของ Google ──
# ใส่ JSON ทั้งก้อนเป็นบรรทัดเดียว
# ถ้าโฮสต์ตัดค่ายาว ๆ (ขึ้น "GOOGLE_JSON_KEY is not valid JSON") ให้เว้นตัวนี้ว่างไว้
# แล้วใช้ GOOGLE_APPLICATION_CREDENTIALS ชี้ไปที่ไฟล์ JSON นอกโฟลเดอร์ที่เสิร์ฟเว็บแทน
GOOGLE_JSON_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=

# ── จำเป็น: Discord OAuth ──
# APP_URL, โดเมนจริงที่เสิร์ฟเว็บ และ redirect URI ใน Discord Developer Portal
# ต้องตรงกันตัวต่อตัว (รวม www กับ apex) ไม่งั้น login จะล้มเหลวแบบเงียบ ๆ
APP_URL=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── จำเป็น: ปลายทางแจ้งเตือน Discord ──
DISCORD_REGISTER_WEBHOOK_URL=
DISCORD_MEDICAL_WEBHOOK_URL=
DISCORD_PROCTOR_WEBHOOK_URL=
DISCORD_OUTPD_WEBHOOK_URL=

# ── ไม่จำเป็น: ทางเข้าสำรองของสิทธิ์แอดมิน ──
# ปกติสิทธิ์อ่านจากชีต — ช่องซ้ายคือชื่อสิทธิ์ ช่องขวาคือลิสต์ Discord ID
#   ทั้งเว็บ (โหมดผู้ดูแลหน้าแรก, ยืนยันจ่ายเงิน, /police, /rostermanage)
#                 → แท็บ NamePD  ช่อง AA2 / AB2  (ชื่อสิทธิ์ ROSTERMANAGE_IDDC)
#   /proctor      → แท็บ Pending ช่อง L1  / M1   (ชื่อสิทธิ์ PROCTOR_IDDC)
# สองตัวข้างล่างเป็นลิสต์สำรองที่ถูกรวมเข้ากับลิสต์ในชีตเสมอ — มีไว้กันกรณีพิมพ์ชื่อสิทธิ์ผิด
# หรือมีคนแทรกแถวจนค่าเลื่อน แล้วไม่มีใครเข้าหน้าที่ใช้แก้ชีตนั้นได้เลย
# ใส่เป็น Discord ID ตัวเลข คั่นด้วยคอมมา เว้นว่างได้ถ้าไม่ต้องการ
# ROSTERMANAGE_IDDC=
# PROCTOR_IDDC=

# ── ไม่จำเป็น: หน้าดู Log & Debug (/police/logs) ──
# ไฟล์ชีตที่เก็บ log — ไม่ใส่ = ใช้ไฟล์ Settings ของบอท (แท็บ Log-Debug-web / Log-Debug-Bot)
# LOG_SHEET_ID=
# เก็บ log ของเว็บไว้กี่วันก่อนลบของเก่า — ไม่ใส่ = 30 · 0 = ไม่ลบเลย
# LOG_RETENTION_DAYS=
#
# ที่อยู่ของบอทกับรหัสผ่าน สำหรับดู log สด 24 ชั่วโมงของบอท
# รหัสต้องตรงกับ LOG_API_TOKEN ใน .env ของบอท
# ไม่ใส่ = แท็บ "บอท (สด)" จะบอกว่ายังไม่ได้ตั้งค่า ส่วนแท็บอื่นยังใช้ได้ปกติ
# BOT_URL=
# BOT_LOG_TOKEN=

# ── ไม่จำเป็น: มีค่า default ใน server/config.ts อยู่แล้ว ──
# CASES_DATA_SHEET_ID=
# PENDING_SPREADSHEET_ID=      # ไม่ใส่ = ใช้ SHEET_ID
# ROSTER_SHEET_ID=             # ไม่ใส่ = ใช้ SHEET_ID
# PENDING_SHEET_NAME=          # ไม่ใส่ = Pending
# MEDICAL_SHEET_NAME=          # ไม่ใส่ = Medical (ใบสมัครแพทย์ อยู่ไฟล์เดียวกับ Pending)
# PORT=                        # เฉพาะตอนรัน .next/standalone เอง (node server.js)
