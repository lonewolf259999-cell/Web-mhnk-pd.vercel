# Dependencies
node_modules/

# Next.js
.next/
out/
next-env.d.ts
.vercel

# Secrets — never commit real values. Set them on the host instead
# (DirectAdmin -> Node.js Selector -> Environment Variables).
# .env.example may be committed, but only with empty values.
.env
.env.*
!.env.example
credentials*.json
service-account*.json
*.pem
*.key

# Logs / runtime artifacts
*.log
*.pid

# TypeScript build info
*.tsbuildinfo

# Deploy bundle (build output)
*.zip

# Local tool state (.claude/launch.json is shared on purpose)
.claude/settings.local.json

# Editor and OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
